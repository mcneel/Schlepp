<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <AssemblyName>Schlepp</AssemblyName>
    <RootNamespace>Schlepp</RootNamespace>
    <TargetExt>.rhp</TargetExt>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Schlepp</AssemblyTitle>
    <Description>Random walk algorithms for Grasshopper2.</Description>
    <Version>2.0.2-beta</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper2" Version="9.0.26230.12303-beta" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework) == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Grasshopper matches a *.ghicon resource to the class of the same name. -->
  <ItemGroup>
    <EmbeddedResource Include="Icons\**\*.ghicon" />
  </ItemGroup>
</Project>